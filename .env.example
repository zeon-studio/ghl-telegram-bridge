# GHL OAuth App Credentials
GHL_CLIENT_ID="your_ghl_client_id"
GHL_CLIENT_SECRET="your_ghl_client_secret"
GHL_REDIRECT_URI="http://localhost:3000/api/auth/callback"
GHL_APP_VERSION_ID="draft"

# GHL Conversation Provider — from the Marketplace Developer Portal:
# App Settings > Conversation Providers > (create one) > copy its ID here.
GHL_CONVERSATION_PROVIDER_ID="your_conversation_provider_id"

# Random secret you generate yourself (e.g. `openssl rand -hex 24`). Append
# it as ?secret=<value> to the Delivery URL you register in the portal
# (see README) — GHL's outbound webhook isn't otherwise authenticated.
GHL_CONVERSATION_PROVIDER_WEBHOOK_SECRET="your_random_webhook_secret"

# Encrypts Telegram bot tokens and phone-account session strings at rest.
# Generate with `openssl rand -hex 32` (32 bytes = 64 hex characters).
# Back it up: lose this key and every connected bot and phone account has to
# be reconnected from scratch.
ENCRYPTION_KEY="your_64_character_hex_key"

# Telegram Phone Connect Credentials — from https://my.telegram.org/apps
# SELF-HOSTED ONLY. Leave unset for a hosted/marketplace deployment: Phone
# Accounts need a persistent MTProto connection (no webhook equivalent), and
# Telegram's API terms make you responsible for every account that logs in
# under your api_id. See README > Phone Accounts.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Largest Telegram attachment to relay, in MB (default 15). Relaying holds a
# file in memory roughly three times over, so this is the real ceiling on a
# small instance — not the Bot API's own 20 MB download cap.
MAX_MEDIA_MB="15"

# How long message logs are kept before GET /api/health prunes them (default 30).
LOG_RETENTION_DAYS="30"

# Database (Supabase Postgres, via Prisma)
#
# Supabase does not hand you variables with these names — DATABASE_URL and
# DIRECT_URL are what THIS app calls them. You are renaming values you already
# have, not hunting for new ones.
#
# If you used Supabase's Vercel/framework integration, it wrote a block of
# POSTGRES_* variables. The mapping is:
#
#   POSTGRES_PRISMA_URL       -> DATABASE_URL   (port 6543)
#   POSTGRES_URL_NON_POOLING  -> DIRECT_URL     (port 5432)
#
# Copying them by hand instead? Supabase Dashboard > Project Settings >
# Database > Connection string, which offers three modes:
#
#   "Transaction pooler" (6543)  -> DATABASE_URL. App queries. PgBouncer, so
#                                   pgbouncer=true is required for Prisma.
#   "Session pooler"     (5432)  -> DIRECT_URL. Prisma Migrate only — the
#                                   transaction pooler can't run the
#                                   session-level statements migrations need.
#
# Do NOT use the third mode, "Direct connection" (db.<project-ref>.supabase.co).
# Supabase made it IPv6-only unless you buy the IPv4 add-on, so it fails on
# Render and most other hosts. The pooler hostname on port 5432 above is the
# one that works.
#
# Both strings embed the database password — after rotating it in the Supabase
# dashboard, update the password segment in BOTH lines. Nothing else changes.
DATABASE_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
